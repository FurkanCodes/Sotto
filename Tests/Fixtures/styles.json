{
  "description": "Shared style cases. keep lists custom words that stay capitalized. Every Sotto implementation must pass these.",
  "cases": [
    { "input": "Sounds good, see you at 3.", "style": "casual", "expected": "sounds good, see you at 3" },
    { "input": "Sounds good, see you at 3.", "style": "standard", "expected": "Sounds good, see you at 3." },
    { "input": "Are you coming tonight?", "style": "casual", "expected": "are you coming tonight?" },
    { "input": "That's great!", "style": "casual", "expected": "that's great!" },
    { "input": "I think so.", "style": "casual", "expected": "I think so" },
    { "input": "I'm on my way.", "style": "casual", "expected": "I'm on my way" },
    { "input": "NASA launched it.", "style": "casual", "expected": "NASA launched it" },
    { "input": "iPhone is charging.", "style": "casual", "expected": "iPhone is charging" },
    { "input": "Mehmet is here.", "style": "casual", "keep": ["Mehmet"], "expected": "Mehmet is here" },
    { "input": "Git status.", "style": "plain", "expected": "git status" },
    { "input": "Wait for it...", "style": "casual", "expected": "wait for it..." },
    { "input": "", "style": "casual", "expected": "" }
  ]
}
