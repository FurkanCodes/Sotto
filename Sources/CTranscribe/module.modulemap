// transcribe.cpp's C API, built by scripts/build-transcribe.sh.
module CTranscribe [system] {
    header "../../Vendor/transcribe/include/transcribe.h"
    link "transcribe"
    link "ggml"
    link "ggml-cpu"
    link "ggml-metal"
    link "ggml-base"
    link "c++"
    link framework "Accelerate"
    link framework "Foundation"
    link framework "Metal"
    link framework "MetalKit"
    export *
}
